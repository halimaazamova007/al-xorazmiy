<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Axborot o'lchov birliklari va Operatsion tizimlar - Test</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            color: #333;
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }
        h1 {
            text-align: center;
            color: #2c3e50;
        }
        .question {
            background: #fff;
            margin-bottom: 20px;
            padding: 15px;
            border-radius: 6px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .question p {
            font-weight: bold;
        }
        label {
            display: block;
            margin: 8px 0;
            cursor: pointer;
        }
        button {
            display: block;
            width: 100%;
            padding: 12px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 5px;
            font-size: 16px;
            cursor: pointer;
            transition: background 0.3s;
        }
        button:hover {
            background-color: #2980b9;
        }
        #result {
            margin-top: 20px;
            text-align: center;
            font-size: 18px;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <h1>Axborot o'lchov birliklari va Operatsion tizimlar</h1>
    <form id="quizForm">

        <!-- 1-savol -->
        <div class="question">
            <p>1. 1 Bayt necha bitga teng?</p>
            <label><input type="radio" name="q1" value="a"> A) 4 bit</label>
            <label><input type="radio" name="q1" value="b"> B) 8 bit</label>
            <label><input type="radio" name="q1" value="c"> C) 1024 bit</label>
            <label><input type="radio" name="q1" value="d"> D) 16 bit</label>
        </div>

        <!-- 2-savol -->
        <div class="question">
            <p>2. Quyidagilardan qaysi biri eng katta axborot o'lchov birligi hisoblanadi?</p>
            <label><input type="radio" name="q2" value="a"> A) Megabayt (MB)</label>
            <label><input type="radio" name="q2" value="b"> B) Gigabayt (GB)</label>
            <label><input type="radio" name="q2" value="c"> C) Terabayt (TB)</label>
            <label><input type="radio" name="q2" value="d"> D) Kilobayt (KB)</label>
        </div>

        <!-- 3-savol -->
        <div class="question">
            <p>3. 1 Kilobayt (KB) necha Baytga teng (o'nlik sanoq sistemasiga yaqin taqribiy yoki xalqaro standart bo'yicha)?</p>
            <label><input type="radio" name="q3" value="a"> A) 100 Bayt</label>
            <label><input type="radio" name="q3" value="b"> B) 1000 Bayt</label>
            <label><input type="radio" name="q3" value="c"> C) 1024 Bayt</label>
            <label><input type="radio" name="q3" value="d"> D) 2048 Bayt</label>
        </div>

        <!-- 4-savol -->
        <div class="question">
            <p>4. Axborotning eng kichik o'lchov birligi nima deb ataladi?</p>
            <label><input type="radio" name="q4" value="a"> A) Bayt</label>
            <label><input type="radio" name="q4" value="b"> B) Bit</label>
            <label><input type="radio" name="q4" value="c"> C) Bod</label>
            <label><input type="radio" name="q4" value="d"> D) Kilobit</label>
        </div>

        <!-- 5-savol -->
        <div class="question">
            <p>5. 1 Megabayt (MB) necha Kilobaytga (KB) teng?</p>
            <label><input type="radio" name="q5" value="a"> A) 512 KB</label>
            <label><input type="radio" name="q5" value="b"> B) 1000 KB</label>
            <label><input type="radio" name="q5" value="c"> C) 1024 KB</label>
            <label><input type="radio" name="q5" value="d"> D) 2048 KB</label>
        </div>

        <!-- 6-savol -->
        <div class="question">
            <p>6. Operatsion tizimning asosiy vazifasi nimadan iborat?</p>
            <label><input type="radio" name="q6" value="a"> A) Matnli hujjatlar yaratish</label>
            <label><input type="radio" name="q6" value="b"> B) Kompyuter qurilmalari va dasturlar ishini boshqarish</label>
            <label><input type="radio" name="q6" value="c"> C) Internet tezligini oshirish</label>
            <label><input type="radio" name="q6" value="d"> D) Viruslarni tozalash</label>
        </div>

        <!-- 7-savol -->
        <div class="question">
            <p>7. Quyidagilardan qaysi biri operatsion tizimga misol bo'la olmaydi?</p>
            <label><input type="radio" name="q7" value="a"> A) Microsoft Windows</label>
            <label><input type="radio" name="q7" value="b"> B) Linux</label>
            <label><input type="radio" name="q7" value="c"> C) Microsoft Word</label>
            <label><input type="radio" name="q7" value="d"> D) macOS</label>
        </div>

        <!-- 8-savol -->
        <div class="question">
            <p>8. Mobil qurilmalar (smartfonlar) uchun mo'ljallangan operatsion tizimni toping:</p>
            <label><input type="radio" name="q8" value="a"> A) MS-DOS</label>
            <label><input type="radio" name="q8" value="b"> B) Android</label>
            <label><input type="radio" name="q8" value="c"> C) Windows 7</label>
            <label><input type="radio" name="q8" value="d"> D) Ubuntu Desktop</label>
        </div>

        <!-- 9-savol -->
        <div class="question">
            <p>9. Operatsion tizim yuklanganda birinchi bo'lib ekranda paydo bo'ladigan asosiy ishchi muhit qanday nomlanadi?</p>
            <label><input type="radio" name="q9" value="a"> A) Fayl menejeri</label>
            <label><input type="radio" name="q9" value="b"> B) Brauzer</label>
            <label><input type="radio" name="q9" value="c"> C) Ishchi stol (Desktop)</label>
            <label><input type="radio" name="q9" value="d"> D) Pult</label>
        </div>

        <!-- 10-savol -->
        <div class="question">
            <p>10. Fayl kengaytmasi (masalan, .docx, .mp3, .exe) nima uchun xizmat qiladi?</p>
            <label><input type="radio" name="q10" value="a"> A) Fayl hajmini o'lchash uchun</label>
            <label><input type="radio" name="q10" value="b"> B) Fayl turi va uni ochuvchi dasturni aniqlash uchun</label>
            <label><input type="radio" name="q10" value="c"> C) Faylni shifrlash uchun</label>
            <label><input type="radio" name="q10" value="d"> D) Internetga ulash uchun</label>
        </div>

        <button type="button" onclick="checkAnswers()">Natijani tekshirish</button>
    </form>

    <div id="result"></div>

    <script>
        function checkAnswers() {
            const answers = {
                q1: 'b',
                q2: 'c',
                q3: 'c',
                q4: 'b',
                q5: 'c',
                q6: 'b',
                q7: 'c',
                q8: 'b',
                q9: 'c',
                q10: 'b'
            };

            let score = 0;
            let total = 10;

            for (let key in answers) {
                const selected = document.querySelector(`input[name="${key}"]:checked`);
                if (selected && selected.value === answers[key]) {
                    score++;
                }
            }

            document.getElementById('result').innerText = `Sizning natijangiz: ${total} tadan ${score} ta to'g'ri!`;
        }
    </script>

</body>
</html>
